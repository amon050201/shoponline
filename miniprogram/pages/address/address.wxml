<wxs module="img" src="../../utils/image.wxs" />
<view class="page-wrap"><view wx:if="{{addresses.length===0}}" class="empty-state"><text>暂无收货地址</text></view><view wx:for="{{addresses}}" wx:key="id" class="card" data-index="{{index}}" data-id="{{item.id}}" bindtap="{{mode==='select'?'selectAddr':''}}"><view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8rpx;"><text style="font-size:28rpx;font-weight:bold;">{{item.receiverName}} {{item.receiverPhone}}</text><text wx:if="{{item.isDefault}}" style="color:#667eea;font-size:22rpx;">默认</text></view><view style="font-size:26rpx;color:#666;">{{item.region}} {{item.detailAddress}}</view><view style="display:flex;gap:20rpx;margin-top:16rpx;justify-content:flex-end;"><text style="color:#667eea;font-size:24rpx;" data-id="{{item.id}}" catchtap="gotoEdit">编辑</text><text style="color:#ff6b6b;font-size:24rpx;" data-id="{{item.id}}" catchtap="deleteAddr">删除</text></view></view><button class="btn-primary" bindtap="gotoEdit" style="margin:30rpx 24rpx;">新增地址</button></view>
