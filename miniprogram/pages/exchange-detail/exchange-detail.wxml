<wxs module="img" src="../../utils/image.wxs" />
<view class="page-wrap"><view wx:if="{{!order}}" class="empty-state"><text>加载中...</text></view><block wx:if="{{order}}"><view style="background:#fff;padding:30rpx;margin-bottom:20rpx;"><view style="display:flex;justify-content:space-between;align-items:center;"><text style="font-size:32rpx;font-weight:bold;">交换详情</text><text class="status-tag status-{{order.status}}">{{order.statusLabel}}</text></view><view style="font-size:24rpx;color:#999;margin-top:8rpx;">{{order.orderNo}}</view><view style="font-size:26rpx;color:#666;margin-top:8rpx;">差价：{{order.priceDifference||0}} 元</view></view><view style="padding:30rpx;display:flex;gap:16rpx;"><button wx:if="{{order.status===0}}" class="btn-primary" style="flex:1;height:72rpx;line-height:72rpx;font-size:28rpx;margin:0;" bindtap="confirm">确认交换</button><button wx:if="{{order.status===0}}" class="btn-ghost" style="flex:1;height:72rpx;line-height:72rpx;font-size:28rpx;margin:0;" bindtap="reject">拒绝</button><button wx:if="{{order.status===0||order.status===1}}" class="btn-ghost" style="flex:1;height:72rpx;line-height:72rpx;font-size:28rpx;margin:0;" bindtap="cancel">取消交换</button></view></block></view>
