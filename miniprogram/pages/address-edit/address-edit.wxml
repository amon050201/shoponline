<wxs module="img" src="../../utils/image.wxs" />
<view class="page-wrap" style="padding:30rpx;"><view style="background:#fff;border-radius:16rpx;padding:30rpx;"><input placeholder="收货人姓名" value="{{receiverName}}" bindinput="onName" style="height:80rpx;border-bottom:1rpx solid #f0f0f0;font-size:28rpx;"/><input placeholder="手机号" type="number" value="{{receiverPhone}}" bindinput="onPhone" style="height:80rpx;border-bottom:1rpx solid #f0f0f0;font-size:28rpx;"/><input placeholder="省市区" value="{{region}}" bindinput="onRegion" style="height:80rpx;border-bottom:1rpx solid #f0f0f0;font-size:28rpx;"/><input placeholder="详细地址" value="{{detailAddress}}" bindinput="onDetail" style="height:80rpx;border-bottom:1rpx solid #f0f0f0;font-size:28rpx;"/><view style="display:flex;align-items:center;margin-top:20rpx;"><switch checked="{{isDefault===1}}" bindchange="setDefault"/><text style="font-size:26rpx;margin-left:10rpx;">设为默认地址</text></view><button class="btn-primary" bindtap="save" style="margin-top:40rpx;">保存</button></view></view>
