<wxs module="img" src="../../utils/image.wxs" />
<view wx:if="{{!order}}" class="empty-state"><text>加载中...</text></view><block wx:if="{{order}}"><view style="background:#fff;padding:30rpx;margin-bottom:20rpx;"><view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16rpx;"><text style="font-size:32rpx;font-weight:bold;">订单详情</text><text class="status-tag status-{{order.status}}">{{order.statusLabel}}</text></view><view style="font-size:26rpx;color:#999;">订单号：{{order.orderNo}}</view><view style="font-size:26rpx;color:#999;">创建时间：{{order.createdTime}}</view></view><view class="card" wx:for="{{items}}" wx:key="id"><view style="display:flex;gap:20rpx;align-items:center;"><image src="{{img.img(item.productImage)}}" mode="aspectFill" style="width:140rpx;height:140rpx;border-radius:8rpx;background:#f0f0f0;"/><view style="flex:1;"><view style="font-size:28rpx;font-weight:600;">{{item.productName}}</view><view style="color:#999;font-size:24rpx;margin-top:8rpx;">x{{item.quantity}}</view><view style="color:#e74c3c;font-size:30rpx;font-weight:bold;margin-top:8rpx;">{{item.totalPrice||item.price}}</view></view></view></view><view class="card"><view style="font-size:28rpx;">收货人：{{order.receiverName}} {{order.receiverPhone}}</view><view style="font-size:26rpx;color:#999;margin-top:8rpx;">地址：{{order.shippingAddress}}</view><view wx:if="{{order.shippingCompany}}" style="font-size:26rpx;color:#999;margin-top:8rpx;">物流：{{order.shippingCompany}} {{order.trackingNumber}}</view><view style="display:flex;justify-content:space-between;margin-top:20rpx;padding-top:20rpx;border-top:1rpx solid #f0f0f0;"><text style="font-size:28rpx;">实付</text><text style="color:#e74c3c;font-size:36rpx;font-weight:bold;">{{order.actualAmount||order.totalAmount}}</text></view></view><view style="padding:30rpx;display:flex;flex-wrap:wrap;gap:16rpx;"><button wx:if="{{order.status===0}}" class="btn-primary" style="flex:1;height:72rpx;line-height:72rpx;font-size:28rpx;margin:0;" bindtap="payOrder">立即支付</button><button wx:if="{{order.status===0}}" class="btn-ghost" style="flex:1;height:72rpx;line-height:72rpx;font-size:28rpx;margin:0;" bindtap="cancel">取消订单</button><button wx:if="{{order.status===2}}" class="btn-primary" style="flex:1;height:72rpx;line-height:72rpx;font-size:28rpx;margin:0;" bindtap="confirmRecv">确认收货</button><button wx:if="{{order.status===2}}" class="btn-ghost" style="flex:1;height:72rpx;line-height:72rpx;font-size:28rpx;margin:0;" bindtap="goLogistics">查看物流</button><button wx:if="{{order.status>=1&&order.status<=3}}" class="btn-ghost" style="flex:1;height:72rpx;line-height:72rpx;font-size:28rpx;margin:0;" bindtap="goRefund">申请退款</button></view></block>
