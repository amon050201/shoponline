<wxs module="img" src="../../utils/image.wxs" />
<view class="page-wrap"><view wx:if="{{items.length===0}}" class="empty-state"><text>暂无收藏</text></view><view wx:for="{{items}}" wx:key="id" class="card" style="display:flex;gap:20rpx;align-items:center;"><image src="{{img.img(item.productImage)}}" mode="aspectFill" style="width:140rpx;height:140rpx;border-radius:8rpx;background:#f0f0f0;" data-id="{{item.productId}}" bindtap="goProduct"/><view style="flex:1;" data-id="{{item.productId}}" bindtap="goProduct"><view style="font-size:28rpx;font-weight:600;">{{item.productName}}</view><view style="color:#e74c3c;font-size:32rpx;font-weight:bold;margin-top:8rpx;">{{item.productPrice}}</view></view><view style="color:#ff6b6b;font-size:24rpx;" data-id="{{item.id}}" catchtap="remove">取消</view></view></view>
