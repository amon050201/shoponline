<wxs module="img" src="../../utils/image.wxs" />
<view class="page-wrap"><view wx:if="{{list.length>0}}" style="text-align:right;padding:16rpx 30rpx;"><text style="color:#667eea;font-size:24rpx;" bindtap="markAll">全部已读</text></view><view wx:if="{{list.length===0}}" class="empty-state"><text>暂无消息</text></view><view wx:for="{{list}}" wx:key="id" class="card" style="{{!item.isRead?'border-left:4rpx solid #667eea;':''}}"><view style="display:flex;justify-content:space-between;align-items:center;"><view style="font-size:28rpx;font-weight:{{item.isRead?400:700}};">{{item.title}}</view><view wx:if="{{!item.isRead}}" style="width:12rpx;height:12rpx;background:#ff6b6b;border-radius:50%;"></view></view><view style="font-size:24rpx;color:#999;margin-top:8rpx;line-height:1.6;">{{item.content}}</view><view style="display:flex;justify-content:space-between;margin-top:12rpx;"><text style="font-size:22rpx;color:#bbb;">{{item.createdTime}}</text><text wx:if="{{!item.isRead}}" style="color:#667eea;font-size:24rpx;" data-id="{{item.id}}" catchtap="markRead">标为已读</text></view></view></view>
