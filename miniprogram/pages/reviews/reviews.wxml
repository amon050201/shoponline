<wxs module="img" src="../../utils/image.wxs" />
<view class="page-wrap" style="padding:30rpx;"><view style="background:#fff;border-radius:16rpx;padding:30rpx;"><view style="font-size:28rpx;font-weight:bold;margin-bottom:20rpx;">写评价</view><view style="display:flex;gap:12rpx;margin-bottom:20rpx;"><text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" data-r="{{item}}" bindtap="setRating" style="font-size:44rpx;{{item<=rating?'color:#ffa502;':'color:#ddd;'}}">★</text></view><textarea placeholder="分享您的使用感受" value="{{content}}" bindinput="onContent" style="width:100%;height:200rpx;border:1rpx solid #f0f0f0;border-radius:8rpx;padding:16rpx;font-size:26rpx;"/><button class="btn-primary" bindtap="submit" style="margin-top:30rpx;">提交评价</button></view></view>
