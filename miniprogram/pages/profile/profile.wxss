/* ============================================
   Profile Page - Enhanced Design
   ============================================ */

/* 用户头部 */
.profile-header {
  position: relative;
  padding: 60rpx 30rpx 40rpx;
  overflow: hidden;
}

.profile-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667eea, #764ba2, #f093fb);
  border-radius: 0 0 50rpx 50rpx;
}

.profile-bg::after {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 50%;
}

.profile-bg::before {
  content: '';
  position: absolute;
  bottom: -80rpx;
  left: -60rpx;
  width: 250rpx;
  height: 250rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 50%;
}

.profile-info {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  border: 4rpx solid rgba(255,255,255,0.4);
  backdrop-filter: blur(4rpx);
}

.avatar-login {
  background: rgba(255,255,255,0.15);
}

.avatar-text {
  font-size: 48rpx;
  color: #fff;
  font-weight: 600;
}

.profile-detail {
  flex: 1;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  display: block;
  margin-bottom: 6rpx;
}

.profile-role {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  display: block;
}

.profile-arrow {
  font-size: 48rpx;
  color: rgba(255,255,255,0.6);
  margin-left: 20rpx;
}

/* 订单快捷入口 */
.order-quick {
  margin-top: -20rpx;
  margin-left: 20rpx;
  margin-right: 20rpx;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
  position: relative;
  z-index: 2;
}

.order-quick-header {
  margin-bottom: 24rpx;
}

.order-quick-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.order-quick-more {
  font-size: 24rpx;
  color: var(--text-muted);
}

.order-status-list {
  display: flex;
  justify-content: space-around;
}

.order-status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: all 0.3s ease;
}

.order-status-item:active {
  transform: scale(0.92);
}

.order-status-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(102,126,234,0.08), rgba(118,75,162,0.08));
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.order-status-item:active .order-status-icon-wrap {
  background: var(--gradient-main);
}

.order-status-icon {
  font-size: 34rpx;
}

.order-status-item:active .order-status-icon {
  color: #fff;
}

.order-status-name {
  font-size: 24rpx;
  color: var(--text-light);
}

/* 功能菜单 */
.menu-list {
  padding: 0;
  margin: 20rpx;
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  border-bottom: 2rpx solid #f5f5f5;
  transition: background 0.3s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: rgba(102,126,234,0.04);
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.menu-icon {
  font-size: 32rpx;
}

.menu-name {
  font-size: 28rpx;
  color: var(--text-primary);
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-badge {
  font-size: 22rpx;
  color: var(--primary);
  background: rgba(102,126,234,0.08);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 退出登录 */
.logout-section {
  padding: 40rpx 40rpx 60rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #fff;
  color: var(--danger);
  border: 2rpx solid var(--danger);
  border-radius: 44rpx;
  font-size: 28rpx;
  text-align: center;
  transition: all 0.3s ease;
  font-weight: 500;
}

.logout-btn:active {
  background: var(--gradient-danger);
  color: #fff;
  transform: scale(0.97);
}
