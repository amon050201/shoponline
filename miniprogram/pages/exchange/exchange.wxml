<wxs module="img" src="../../utils/image.wxs" />
<view class="page-wrap"><view wx:if="{{orders.length===0}}" class="empty-state"><text>暂无交换订单</text></view><view wx:for="{{orders}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="goDetail"><view style="display:flex;justify-content:space-between;margin-bottom:8rpx;"><text style="font-size:24rpx;color:#999;">{{item.orderNo}}</text><text class="status-tag status-{{item.status}}">{{item.statusLabel}}</text></view><view style="font-size:26rpx;color:#666;">差价：{{item.priceDifference||0}}元</view><view style="font-size:24rpx;color:#999;margin-top:4rpx;">{{item.createdTime}}</view></view></view>
