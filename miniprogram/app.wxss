page {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx; color: #333; background: #f5f5f5; line-height: 1.6;
}
.container { padding: 24rpx; }
.page-wrap { min-height: 100vh; background: #f5f5f5; }
.btn-primary {
  display: flex; align-items: center; justify-content: center;
  height: 88rpx; background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff; border-radius: 44rpx; font-size: 30rpx; font-weight: bold;
  border: none; margin: 20rpx 0;
}
.btn-primary:active { opacity: 0.85; }
.btn-ghost {
  display: flex; align-items: center; justify-content: center;
  height: 88rpx; background: #fff; color: #667eea;
  border-radius: 44rpx; font-size: 30rpx; border: 2rpx solid #667eea;
}
.btn-sm { height: 56rpx; padding: 0 24rpx; font-size: 24rpx; border-radius: 28rpx; }
.section-title {
  display: flex; align-items: center; padding: 30rpx 24rpx 16rpx;
  font-size: 32rpx; font-weight: bold;
}
.section-title::before {
  content: ''; width: 6rpx; height: 28rpx;
  background: linear-gradient(180deg, #667eea, #764ba2);
  border-radius: 3rpx; margin-right: 12rpx;
}
.empty-state {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 100rpx 0; color: #999; font-size: 28rpx;
}
.empty-state image { width: 160rpx; height: 160rpx; margin-bottom: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin: 16rpx 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.status-tag { display: inline-block; padding: 4rpx 16rpx; border-radius: 8rpx; font-size: 22rpx; }
.status-0 { background: #fff3e0; color: #e65100; }
.status-1 { background: #e8f5e9; color: #2e7d32; }
.status-2 { background: #e3f2fd; color: #1565c0; }
.status-3 { background: #f3e5f5; color: #6a1b9a; }
.status-4 { background: #ffebee; color: #c62828; }
.status-5 { background: #fff8e1; color: #f57f17; }
.load-more { text-align: center; padding: 24rpx; color: #999; font-size: 24rpx; }
.search-bar { display: flex; align-items: center; padding: 16rpx 24rpx; background: #fff; }
.search-bar input { flex: 1; height: 64rpx; background: #f5f5f5; border-radius: 32rpx; padding: 0 24rpx; font-size: 28rpx; }
.search-bar button { margin-left: 16rpx; height: 64rpx; padding: 0 24rpx; font-size: 26rpx; background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; border-radius: 32rpx; border: none; }
.banner-wrap { margin: 16rpx 24rpx; border-radius: 16rpx; overflow: hidden; }
.banner-wrap swiper { height: 320rpx; }
.banner-wrap image { width: 100%; height: 320rpx; }
.modal-mask { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 999; display: flex; align-items: center; justify-content: center; }
.modal-content { width: 600rpx; background: #fff; border-radius: 16rpx; padding: 40rpx; }
.product-grid { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 0 24rpx; }
.product-card { width: calc(50% - 8rpx); background: #fff; border-radius: 16rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); }
.product-card image { width: 100%; height: 340rpx; background: #f0f0f0; display: block; }
.product-card .info { padding: 16rpx; }
.product-card .name { font-size: 28rpx; font-weight: 600; height: 76rpx; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.product-card .price { color: #e74c3c; font-size: 34rpx; font-weight: bold; margin-top: 8rpx; }
.product-card .orig { color: #999; font-size: 24rpx; text-decoration: line-through; margin-left: 8rpx; }
.recommend-scroll { white-space: nowrap; padding: 0 24rpx; }
.recommend-item { display: inline-block; width: 220rpx; margin-right: 16rpx; background: #fff; border-radius: 12rpx; overflow: hidden; }
.recommend-item image { width: 220rpx; height: 220rpx; background: #f0f0f0; display: block; }
.recommend-item .name { font-size: 24rpx; padding: 10rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.recommend-item .price { color: #e74c3c; font-size: 28rpx; font-weight: bold; padding: 0 10rpx 10rpx; }
