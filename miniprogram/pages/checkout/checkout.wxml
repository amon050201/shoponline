<wxs module="img" src="../../utils/image.wxs" />
<view class="page-wrap"><view class="card" bindtap="chooseAddr"><view style="font-size:28rpx;font-weight:bold;margin-bottom:8rpx;">收货地址</view><view wx:if="{{address}}" style="font-size:26rpx;color:#333;">{{address.receiverName}} {{address.receiverPhone}}</view><view wx:if="{{address}}" style="font-size:24rpx;color:#999;margin-top:4rpx;">{{address.region}} {{address.detailAddress}}</view><view wx:if="{{!address}}" style="font-size:26rpx;color:#999;">请选择收货地址 ></view></view><view class="card" wx:for="{{cartItems}}" wx:key="productId"><view style="display:flex;gap:16rpx;align-items:center;"><image src="{{img.img(item.productImage)}}" mode="aspectFill" style="width:120rpx;height:120rpx;border-radius:8rpx;background:#f0f0f0;"/><view style="flex:1;"><view style="font-size:28rpx;">{{item.productName}}</view><view style="color:#999;font-size:24rpx;">x{{item.quantity}}</view></view><view style="color:#e74c3c;font-weight:bold;">{{img.price((item.productPrice||0)*(item.quantity||1))}}</view></view></view><view class="card" wx:if="{{mode==='cart'}}"><view style="font-size:26rpx;color:#999;margin-bottom:8rpx;">备注</view><input placeholder="选填" value="{{remark}}" bindinput="onRemark" style="font-size:26rpx;"/></view><view style="position:fixed;bottom:0;left:0;right:0;background:#fff;padding:20rpx 30rpx;display:flex;align-items:center;justify-content:space-between;box-shadow:0 -2rpx 10rpx rgba(0,0,0,0.05);"><view><text style="font-size:24rpx;color:#999;">合计：</text><text style="color:#e74c3c;font-size:36rpx;font-weight:bold;">{{totalAmount}}</text></view><button class="btn-primary" style="width:200rpx;height:72rpx;line-height:72rpx;font-size:28rpx;margin:0;" bindtap="submitOrder">{{mode==='pay'?'确认支付':'提交订单'}}</button></view></view>
