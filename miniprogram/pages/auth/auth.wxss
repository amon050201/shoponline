/* ============================================
   Auth Page - Enhanced Design
   ============================================ */

.auth-container {
  background: linear-gradient(180deg, #fff 0%, #f5f7fa 100%);
  min-height: 100vh;
}

/* Logo */
.auth-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0 40rpx;
  animation: fadeInUp 0.6s ease;
}

.logo-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(102,126,234,0.1), rgba(118,75,162,0.1));
  border-radius: 50%;
}

.logo-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.logo-subtitle {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* Tab 切换 */
.auth-tabs {
  display: flex;
  margin: 0 60rpx;
  border-bottom: 2rpx solid var(--border-color);
  animation: fadeInUp 0.6s ease;
  animation-delay: 0.1s;
}

.auth-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: var(--text-muted);
  position: relative;
  transition: all 0.3s ease;
}

.auth-tab.active {
  color: var(--text-primary);
  font-weight: 600;
}

.auth-tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: var(--gradient-main);
  border-radius: 2rpx;
}

/* 表单 */
.auth-form {
  padding: 40rpx 60rpx;
  animation: fadeInUp 0.6s ease;
  animation-delay: 0.2s;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f6fa;
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  height: 96rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.form-input-wrap:focus-within {
  border-color: var(--primary);
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(102,126,234,0.08);
}

.form-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  height: 96rpx;
  font-size: 28rpx;
  background: transparent;
  color: var(--text-primary);
}

.form-input::placeholder {
  color: #bbb;
}

.form-toggle-pwd {
  font-size: 28rpx;
  padding: 10rpx;
  flex-shrink: 0;
}

/* 验证码 */
.captcha-wrap .captcha-image {
  width: 160rpx;
  height: 60rpx;
  border-radius: var(--radius-sm);
  margin-left: 12rpx;
}

/* 用户协议 */
.form-agreement {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 30rpx;
}

.form-agreement .checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #ddd;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #fff;
  flex-shrink: 0;
  margin-top: 4rpx;
  transition: all 0.3s ease;
}

.form-agreement .checkbox.checked {
  background: var(--gradient-main);
  border-color: transparent;
}

.agreement-text {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.6;
}

.agreement-link {
  color: var(--primary);
}

/* 错误提示 */
.form-error {
  background: #fff5f5;
  border: 2rpx solid #ffcccc;
  border-radius: var(--radius-sm);
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  animation: shake 0.4s ease;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  75% { transform: translateX(10rpx); }
}

.form-error text {
  font-size: 24rpx;
  color: var(--danger);
}

/* 提交按钮 */
.auth-submit {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
  transition: all 0.3s ease;
}

.auth-submit:active {
  transform: scale(0.97);
}

.auth-submit.disabled {
  background: #ccc;
  box-shadow: none;
}
