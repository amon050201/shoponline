<wxs module="img" src="../../utils/image.wxs" />
<view class="page-wrap"><view wx:if="{{!info}}" class="empty-state"><text>加载中...</text></view><block wx:if="{{info}}"><view class="card"><view style="font-size:28rpx;font-weight:bold;margin-bottom:12rpx;">物流信息</view><view style="font-size:26rpx;color:#666;">快递公司：{{info.shippingCompany||'暂无'}}</view><view style="font-size:26rpx;color:#666;margin-top:8rpx;">快递单号：{{info.trackingNumber||'暂无'}}</view><view style="font-size:26rpx;color:#666;margin-top:8rpx;">发货时间：{{info.deliveryTime||'暂无'}}</view></view><view class="card"><view style="font-size:28rpx;font-weight:bold;margin-bottom:12rpx;">收货信息</view><view style="font-size:26rpx;color:#666;">收货人：{{info.receiverName}}</view><view style="font-size:26rpx;color:#666;margin-top:8rpx;">地址：{{info.shippingAddress}}</view></view><view class="card"><view style="font-size:28rpx;font-weight:bold;margin-bottom:12rpx;">物流状态</view><view wx:if="{{info.status===2}}" style="font-size:26rpx;color:#1565c0;">运输中</view><view wx:if="{{info.status===3}}" style="font-size:26rpx;color:#2e7d32;">已签收</view><view wx:if="{{info.status<2}}" style="font-size:26rpx;color:#999;">等待发货</view></view></block></view>
