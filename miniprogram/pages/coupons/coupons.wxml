<wxs module="img" src="../../utils/image.wxs" />
<view class="page-wrap"><view style="display:flex;background:#fff;margin-bottom:20rpx;"><view data-tab="0" bindtap="switchTab" style="flex:1;text-align:center;padding:20rpx;font-size:28rpx;{{tab===0?'color:#667eea;border-bottom:3rpx solid #667eea;':''}}">可领取</view><view data-tab="1" bindtap="switchTab" style="flex:1;text-align:center;padding:20rpx;font-size:28rpx;{{tab===1?'color:#667eea;border-bottom:3rpx solid #667eea;':''}}">我的</view></view><block wx:if="{{tab===0}}"><view wx:if="{{coupons.length===0}}" class="empty-state"><text>暂无可领优惠券</text></view><view wx:for="{{coupons}}" wx:key="id" class="card" style="background:linear-gradient(135deg,#fff5f5,#fff8e1);"><view style="display:flex;justify-content:space-between;align-items:center;"><view><text style="font-size:48rpx;font-weight:bold;color:#e74c3c;">{{item.value}}{{item.type==='discount'?'折':'元'}}</text><text style="font-size:24rpx;color:#999;"> {{item.type==='discount'?'折扣券':'满减券'}}</text></view><button class="btn-primary" style="width:140rpx;height:60rpx;line-height:60rpx;font-size:24rpx;margin:0;" data-id="{{item.id}}" bindtap="receive">立即领取</button></view><view style="font-size:28rpx;font-weight:bold;margin-top:8rpx;">{{item.name}}</view><view style="font-size:24rpx;color:#999;margin-top:4rpx;">{{item.minAmount>0?'满'+item.minAmount+'元可用':'无门槛'}} | {{item.description}}</view></view></block><block wx:if="{{tab===1}}"><view wx:if="{{myCoupons.length===0}}" class="empty-state"><text>暂无优惠券</text></view><view wx:for="{{myCoupons}}" wx:key="id" class="card"><view style="font-size:32rpx;font-weight:bold;">{{item.couponValue}}{{item.couponType==='discount'?'折':'元'}} <text style="font-size:24rpx;color:#999;">{{item.couponType==='discount'?'折扣券':'满减券'}}</text></view><view style="font-size:26rpx;color:#666;margin-top:4rpx;">{{item.couponName}}</view><view style="font-size:24rpx;color:#999;margin-top:4rpx;">{{item.status===0?'可用':(item.status===1?'已使用':'已过期')}}</view></view></block></view>
