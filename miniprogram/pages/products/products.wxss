/* ============================================
   Products Page - Enhanced Design
   ============================================ */

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #f5f6fa, #eeeff8);
  border-radius: 44rpx;
  padding: 0 24rpx;
  height: 72rpx;
  transition: all 0.3s ease;
}

.search-input-wrap:focus-within {
  background: #fff;
  box-shadow: 0 0 0 2rpx rgba(102,126,234,0.2);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  background: transparent;
}

.search-clear {
  font-size: 28rpx;
  color: var(--text-muted);
  padding: 10rpx;
}

.search-btn {
  font-size: 28rpx;
  color: var(--primary);
  margin-left: 20rpx;
  padding: 10rpx;
  white-space: nowrap;
  font-weight: 500;
}

/* 搜索历史 */
.search-history {
  margin-bottom: 0;
}

.history-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.history-clear {
  font-size: 24rpx;
  color: var(--text-muted);
}

.keywords-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.keyword-tag {
  display: inline-block;
  padding: 10rpx 24rpx;
  background: #f5f6fa;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: var(--text-light);
  transition: all 0.3s ease;
}

.keyword-tag:active {
  background: rgba(102,126,234,0.12);
  color: var(--primary);
  transform: scale(1.05);
}

/* 分类导航 */
.category-scroll {
  background: #fff;
  white-space: nowrap;
  border-bottom: 2rpx solid var(--border-color);
}

.category-list {
  display: flex;
  padding: 0 20rpx;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: var(--text-light);
  position: relative;
  transition: color 0.3s ease;
}

.category-item.active {
  color: var(--primary);
  font-weight: 500;
}

.category-indicator {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 4rpx;
  background: var(--gradient-main);
  border-radius: 2rpx;
}

/* 排序栏 */
.sort-bar {
  background: #fff;
  border-bottom: 2rpx solid var(--border-color);
}

.sort-list {
  display: flex;
  padding: 0 20rpx;
}

.sort-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: var(--text-light);
  transition: color 0.3s ease;
}

.sort-item.active {
  color: var(--primary);
  font-weight: 500;
}

/* 搜索结果信息 */
.search-result-info {
  padding: 20rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
}

/* 商品网格 */
.products-content {
  padding-top: 10rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 20rpx;
}

/* 商品卡片 */
.product-card {
  background: #fff;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s ease;
  position: relative;
}

.product-card:active {
  transform: scale(0.97);
}

.product-card::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3rpx;
  background: var(--gradient-main);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.product-card:active::after {
  opacity: 1;
}

.product-image {
  width: 100%;
  height: 340rpx;
  background: #f0f0f0;
  transition: transform 0.5s ease;
}

.product-card:active .product-image {
  transform: scale(1.05);
}

.product-info {
  padding: 16rpx 20rpx 20rpx;
}

.product-name {
  font-size: 26rpx;
  line-height: 1.4;
  height: 72rpx;
  margin-bottom: 8rpx;
  color: var(--text-primary);
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.product-tag {
  font-size: 20rpx;
  color: var(--primary);
  background: rgba(102,126,234,0.08);
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.price-integer {
  font-size: 34rpx;
  font-weight: 700;
}

.original-price {
  font-size: 22rpx;
  color: #ccc;
  text-decoration: line-through;
}

.product-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-sales {
  font-size: 22rpx;
  color: var(--text-muted);
}

.product-rating {
  font-size: 22rpx;
  color: var(--warning);
}
